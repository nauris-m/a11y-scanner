{
  "name": "web-a11y-scanner",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Chrome extension that finds accessibility problems on the current page",
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "axe-core": "^4.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/chrome": "^0.0.287",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.5.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4"
  }
}
